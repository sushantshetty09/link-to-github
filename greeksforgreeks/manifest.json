{
  "manifest_version": 3,
  "name": "GfGSync-Mini",
  "version": "1.0.0",
  "description": "Automatically push accepted GeeksforGeeks practice submissions to your GitHub repository.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.geeksforgeeks.org/*",
    "https://practiceapi.geeksforgeeks.org/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.geeksforgeeks.org/problems/*"
      ],
      "js": [
        "injected-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.geeksforgeeks.org/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected-interceptor.js"
      ],
      "matches": [
        "https://www.geeksforgeeks.org/*"
      ]
    }
  ]
}
